NODE_ENV=development
PORT=3000
API_ORIGIN=http://localhost:3000
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://reachinbox:local_dev_only@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox-emails

# Generate one or more accounts with `npm run ethereal`; paste each returned object into this JSON array.
SMTP_SENDERS_JSON=[{"id":"sender-1","name":"Ethereal sender 1","host":"smtp.ethereal.email","port":587,"secure":false,"user":"REPLACE_ME","pass":"REPLACE_ME","from":"ReachInbox Demo <REPLACE_ME>"}]

WORKER_CONCURRENCY=5
MIN_DELAY_SECONDS=2
MAX_EMAILS_PER_HOUR=200

# Google OAuth web client. Callback URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Slack OAuth app. Redirect URI: http://localhost:3000/auth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:3000/auth/slack/callback

# Use stable random values (32+ characters) and keep them secret.
SESSION_SECRET=replace-with-a-long-random-session-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-encryption-secret
QUEUE_DASHBOARD_EMAILS=your-google-email@example.com
